<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apex EV | O Futuro da Mobilidade Elétrica</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;900&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icones -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* CSS Reset e Variáveis */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-color: #0b0f19;
            --card-bg: #151c2e;
            --primary: #00f2fe;
            --secondary: #4facfe;
            --text-light: #f1f5f9;
            --text-dim: #94a3b8;
            --font-title: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-light);
            font-family: var(--font-body);
            font-size: 18px;
            overflow-x: hidden;
        }

        /* Header / Navbar */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 8%;
            background: rgba(11, 15, 25, 0.9);
            backdrop-filter: blur(10px);
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(0, 242, 254, 0.1);
        }

        .logo {
            font-family: var(--font-title);
            font-size: 28px;
            font-weight: 900;
            color: #fff;
            letter-spacing: 2px;
        }

        .logo span {
            color: var(--primary);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 30px;
        }

        nav a {
            color: var(--text-light);
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        nav a:hover {
            color: var(--primary);
        }

        .btn-nav {
            border: 1px solid var(--primary);
            padding: 8px 20px;
            border-radius: 5px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 700;
            transition: 0.3s;
        }

        .btn-nav:hover {
            background: var(--primary);
            color: var(--bg-color);
            box-shadow: 0 0 15px rgba(0, 242, 254, 0.4);
        }

        /* Hero Section */
        .hero {
            height: 100vh;
            background: linear-gradient(rgba(11, 15, 25, 0.6), var(--bg-color)), 
                        url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 0 20px;
        }

        .hero h1 {
            font-family: var(--font-title);
            font-size: 3.5rem;
            margin-bottom: 15px;
            text-transform: uppercase;
            letter-spacing: 3px;
        }

        .hero h1 span {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 1.4rem;
            color: var(--text-dim);
            max-width: 600px;
            margin-bottom: 30px;
        }

        .btn-primary {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            color: #000;
            padding: 12px 35px;
            font-weight: 700;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            font-size: 1.1rem;
            transition: 0.3s;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 0 20px rgba(0, 242, 254, 0.6);
        }

        /* Seção de Modelos */
        .models-section {
            padding: 100px 8% 50px;
        }

        .section-title {
            text-align: center;
            margin-bottom: 60px;
        }

        .section-title h2 {
            font-family: var(--font-title);
            font-size: 2.5rem;
            letter-spacing: 2px;
        }

        .section-title p {
            color: var(--text-dim);
        }

        .cards-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 30px;
        }

        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: 0.4s;
            position: relative;
        }

        .card:hover {
            transform: translateY(-10px);
            border-color: var(--primary);
            box-shadow: 0 10px 30px rgba(0, 242, 254, 0.15);
        }

        .card-tag {
            position: absolute;
            top: 15px;
            left: 15px;
            background: rgba(0, 242, 254, 0.2);
            border: 1px solid var(--primary);
            color: var(--primary);
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 700;
            text-transform: uppercase;
        }

        .card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
        }

        .card-content {
            padding: 25px;
        }

        .card-title {
            font-family: var(--font-title);
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        /* Tabela de Especificações */
        .specs-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 25px;
            background: rgba(0, 0, 0, 0.2);
            padding: 15px;
            border-radius: 8px;
        }

        .spec-item {
            display: flex;
            flex-direction: column;
        }

        .spec-item i {
            color: var(--primary);
            margin-bottom: 5px;
        }

        .spec-label {
            font-size: 0.85rem;
            color: var(--text-dim);
        }

        .spec-value {
            font-weight: 700;
            font-size: 1.1rem;
        }

        .card-price {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 20px;
            display: block;
        }

        .btn-card {
            display: block;
            width: 100%;
            text-align: center;
            background: transparent;
            border: 1px solid var(--text-dim);
            color: var(--text-light);
            padding: 10px;
            border-radius: 5px;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        .card:hover .btn-card {
            background: var(--primary);
            border-color: var(--primary);
            color: var(--bg-color);
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 40px 20px;
            background-color: #060911;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            margin-top: 80px;
            color: var(--text-dim);
            font-size: 0.9rem;
        }

        footer p {
            margin-top: 10px;
        }

        /* Responsividade */
        @media (max-width: 768px) {
            header {
                padding: 15px 5%;
            }
            nav {
                display: none; /* Em produção, adicione um menu hambúrguer */
            }
            .hero h1 {
                font-size: 2.2rem;
            }
        }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <div class="logo">APEX <span>EV</span></div>
        <nav>
            <ul>
                <li><a href="#home">Início</a></li>
                <li><a href="#modelos">Modelos</a></li>
                <li><a href="#tecnologia">Tecnologia</a></li>
            </ul>
        </nav>
        <a href="#modelos" class="btn-nav">Tenho Interesse</a>
    </header>

    <!-- Hero Section -->
    <section class="hero" id="home">
        <h1>O Futuro É <span>Elétrico</span></h1>
        <p>Performance extrema, zero emissões e tecnologia de ponta moldada para a nova era da mobilidade humana.</p>
        <a href="#modelos" class="btn-primary">Explorar Modelos</a>
    </section>

    <!-- Seção de Modelos -->
    <section class="models-section" id="modelos">
        <div class="section-title">
            <h2>Nossa Linha de Veículos</h2>
            <p>Escolha o Apex projetado perfeitamente para o seu estilo de vida</p>
        </div>

        <div class="cards-container">

            <!-- Modelo 1: Esportivo -->
            <div class="card">
                <span class="card-tag">Esportivo</span>
                <img src="https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&w=800&q=80" alt="Apex Hyperion Carro Esportivo">
                <div class="card-content">
                    <h3 class="card-title">Apex Hyperion</h3>
                    
                    <div class="specs-grid">
                        <div class="spec-item">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="spec-label">0 a 100 km/h</span>
                            <span class="spec-value">2.1 seg</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-battery-full"></i>
                            <span class="spec-label">Autonomia</span>
                            <span class="spec-value">620 km</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-bolt"></i>
                            <span class="spec-label">Potência</span>
                            <span class="spec-value">1.020 cv</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-car-side"></i>
                            <span class="spec-label">Tração</span>
                            <span class="spec-value">AWD Total</span>
                        </div>
                    </div>

                    <span class="card-price">R$ 890.000</span>
                    <a href="#" class="btn-card">Reservar Agora</a>
                </div>
            </div>

            <!-- Modelo 2: SUV -->
            <div class="card">
                <span class="card-tag">SUV Premium</span>
                <img src="https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?auto=format&fit=crop&w=800&q=80" alt="Apex Terra SUV">
                <div class="card-content">
                    <h3 class="card-title">Apex Terra</h3>
                    
                    <div class="specs-grid">
                        <div class="spec-item">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="spec-label">0 a 100 km/h</span>
                            <span class="spec-value">3.8 seg</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-battery-full"></i>
                            <span class="spec-label">Autonomia</span>
                            <span class="spec-value">580 km</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-bolt"></i>
                            <span class="spec-label">Potência</span>
                            <span class="spec-value">540 cv</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-users"></i>
                            <span class="spec-label">Ocupantes</span>
                            <span class="spec-value">7 Lugares</span>
                        </div>
                    </div>

                    <span class="card-price">R$ 520.000</span>
                    <a href="#" class="btn-card">Reservar Agora</a>
                </div>
            </div>

            <!-- Modelo 3: Hatch -->
            <div class="card">
                <span class="card-tag">Hatch Urbano</span>
                <img src="https://images.unsplash.com/photo-1541899481282-d53bffe3c35d?auto=format&fit=crop&w=800&q=80" alt="Apex Pulse Hatchback">
                <div class="card-content">
                    <h3 class="card-title">Apex Pulse</h3>
                    
                    <div class="specs-grid">
                        <div class="spec-item">
                            <i class="fa-solid fa-gauge-high"></i>
                            <span class="spec-label">0 a 100 km/h</span>
                            <span class="spec-value">4.9 seg</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-battery-full"></i>
                            <span class="spec-label">Autonomia</span>
                            <span class="spec-value">450 km</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-bolt"></i>
                            <span class="spec-label">Potência</span>
                            <span class="spec-value">300 cv</span>
                        </div>
                        <div class="spec-item">
                            <i class="fa-solid fa-charging-station"></i>
                            <span class="spec-label">Carga Rápida</span>
                            <span class="spec-value">20 min (80%)</span>
                        </div>
                    </div>

                    <span class="card-price">R$ 280.000</span>
                    <a href="#" class="btn-card">Reservar Agora</a>
                </div>
            </div>

        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="logo">APEX <span>EV</span></div>
        <p>&copy; 2026 Apex EV Motors Inc. Todos os direitos reservados.</p>
    </footer>

</body>
</html>
